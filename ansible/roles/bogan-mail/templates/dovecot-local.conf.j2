# Managed by ccdc-bogan-mail (loaded last from conf.d, overrides defaults).
# IMAP/POP3 for system (AD-mirrored) users. Postfix handles local delivery to
# Maildir, so Dovecot LMTP is not used here.
# INTENTIONAL: plaintext auth without TLS is allowed (sniffable creds) — a
# realistic weak-mail config. Accounts/passwords mirror AD (Deathstar).
protocols = imap pop3
ssl = no
disable_plaintext_auth = no
auth_mechanisms = plain login
mail_location = maildir:~/Maildir
