# Managed by ccdc-bogan-mail. Minimal Postfix for the StarBar range.
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
compatibility_level = 3.6

myhostname = bogan.{{ ccdc_domain.fqdn }}
mydomain = {{ ccdc_domain.fqdn }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination = $myhostname, bogan, localhost.$mydomain, localhost, $mydomain

{% set prefix = ansible_default_ipv4.address.split('.')[0:3] | join('.') %}
mynetworks = 127.0.0.0/8 {{ prefix }}.0/24

home_mailbox = Maildir/
mailbox_size_limit = 0
recipient_delimiter = +
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
