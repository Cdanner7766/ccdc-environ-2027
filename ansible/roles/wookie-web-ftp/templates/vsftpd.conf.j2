# Managed by ccdc-wookie-web-ftp.
# INTENTIONAL weak-FTP config: a local FTP account with a weak password and
# WRITE access to the web root. A foothold here can drop files into the site
# and read config.php (DB creds). Static misconfig only.
listen=YES
listen_ipv6=NO
anonymous_enable={{ 'YES' if wookie_ftp_anonymous else 'NO' }}
local_enable=YES
write_enable=YES
local_umask=022
dirmessage_enable=YES
use_localtime=YES
xferlog_enable=YES
connect_from_port_20=YES
chroot_local_user=NO
pam_service_name=vsftpd
pasv_enable=YES
pasv_min_port=40000
pasv_max_port=40100
