# Managed by ccdc-tython-payment-web.
<VirtualHost *:80>
    ServerName {{ ansible_hostname }}
    DocumentRoot {{ tython_docroot }}
    DirectoryIndex index.php index.html

    <Directory {{ tython_docroot }}>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        {% if tython_expose_dotgit %}
        # INTENTIONAL: do NOT block .git/ — it is left downloadable on purpose.
        {% endif %}
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/starbar_error.log
    CustomLog ${APACHE_LOG_DIR}/starbar_access.log combined
</VirtualHost>
